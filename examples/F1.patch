+  static final RegExp _safeSourceId = RegExp(r'^[A-Za-z0-9_-]{1,64}$');
+
+  /// Trust boundary for remote-supplied [sourceId]: allowlist charset only,
+  /// rejecting separators, `..`, absolute paths, and empty values, then
+  /// canonicalizes and contains the final path under [configDir].
+  static File _cachedSourceFile(Directory configDir, String sourceId) {
+    if (!_safeSourceId.hasMatch(sourceId)) {
+      throw FormatException('Invalid sourceId: "$sourceId"');
+    }
+    final filePath = p.normalize(p.join(configDir.path, '$sourceId-config.json'));
+    final basePath = p.normalize(configDir.path);
+    if (!p.isWithin(basePath, filePath)) {
+      throw FormatException('Invalid sourceId: "$sourceId"');
+    }
+    return File(filePath);
+  }
